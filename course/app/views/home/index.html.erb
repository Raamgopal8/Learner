<!-- FAQ Section -->
<section class="faq-section" id="faq" data-controller="faq">
  <div class="container mx-auto px-6">
    <div class="text-center mb-16" data-aos="fade-up">
      <span class="inline-block px-4 py-2 rounded-full bg-indigo-100 text-indigo-700 text-sm font-medium mb-4">
        FAQ
      </span>
      <h2 class="text-4xl font-bold text-gray-900 mb-6">
        Frequently Asked<br>
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 to-purple-600">Questions</span>
      </h2>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        Find answers to common questions about our platform and courses.
      </p>
    </div>

    <div class="faq-container">
      <!-- FAQ Item 1 -->
      <div class="faq-item" data-faq-target="item">
        <div class="faq-question" data-action="click->faq#toggle">
          <h3>What is Tutorx?</h3>
          <div class="faq-icon" data-faq-target="icon">
            <i class="fas fa-chevron-down"></i>
          </div>
        </div>
        <div class="faq-answer hidden" data-faq-target="content">
          <div class="faq-answer-content">
            Tutorx is a premium learning platform designed to help you master new skills through expert-led courses, interactive projects, and a community-driven learning environment.
          </div>
        </div>
      </div>

      <!-- FAQ Item 2 -->
      <div class="faq-item" data-faq-target="item">
        <div class="faq-question" data-action="click->faq#toggle">
          <h3>Are the courses self-paced?</h3>
          <div class="faq-icon" data-faq-target="icon">
            <i class="fas fa-chevron-down"></i>
          </div>
        </div>
        <div class="faq-answer hidden" data-faq-target="content">
          <div class="faq-answer-content">
            Yes! Once you enroll in a course, you have lifetime access to the materials. You can learn at your own pace, anytime, and on any device that suits your schedule.
          </div>
        </div>
      </div>

      <!-- FAQ Item 3 -->
      <div class="faq-item" data-faq-target="item">
        <div class="faq-question" data-action="click->faq#toggle">
          <h3>How do I get support during a course?</h3>
          <div class="faq-icon" data-faq-target="icon">
            <i class="fas fa-chevron-down"></i>
          </div>
        </div>
        <div class="faq-answer hidden" data-faq-target="content">
          <div class="faq-answer-content">
            Each course features a dedicated Q&A section and access to our community forums. Our instructors and mentors also hold regular office hours to help you overcome any challenges.
          </div>
        </div>
      </div>

      <!-- FAQ Item 4 -->
      <div class="faq-item" data-faq-target="item">
        <div class="faq-question" data-action="click->faq#toggle">
          <h3>Is there a certification upon completion?</h3>
          <div class="faq-icon" data-faq-target="icon">
            <i class="fas fa-chevron-down"></i>
          </div>
        </div>
        <div class="faq-answer hidden" data-faq-target="content">
          <div class="faq-answer-content">
            Absolutely. Upon successfully completing all modules and projects in a course, you will receive a verified certificate that you can share on LinkedIn or with potential employers.
          </div>
        </div>
      </div>

      <!-- FAQ Item 5 -->
      <div class="faq-item" data-faq-target="item">
        <div class="faq-question" data-action="click->faq#toggle">
          <h3>Can I access courses on mobile?</h3>
          <div class="faq-icon" data-faq-target="icon">
            <i class="fas fa-chevron-down"></i>
          </div>
        </div>
        <div class="faq-answer hidden" data-faq-target="content">
          <div class="faq-answer-content">
            Yes, Tutorx is fully optimized for mobile devices. You can learn on the go using your smartphone or tablet through our responsive web interface.
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

