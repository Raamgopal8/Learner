<!-- Animated Background -->
<div class="fixed inset-0 -z-10 overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-br from-indigo-50 to-blue-50"></div>
  <div class="absolute inset-0 bg-grid-indigo-200/50 [mask-image:linear-gradient(0deg,white,transparent)]"></div>
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,var(--primary)_0,transparent_70%)] opacity-10"></div>
</div>

<!-- Floating Elements -->
<div class="floating-elements">
  <div class="floating-1"></div>
  <div class="floating-2"></div>
  <div class="floating-3"></div>
</div>

<!-- Hero Section -->
<section class="relative min-h-screen flex items-center pt-24 pb-20 overflow-hidden">
  <div class="container mx-auto px-6">
    <div class="flex flex-col lg:flex-row items-center">
      <!-- Hero Content -->
      <div class="lg:w-1/2 mb-16 lg:mb-0" data-aos="fade-right" data-aos-duration="800">
        <div class="max-w-xl">
          <% if user_signed_in? %>
            <h1 class="text-5xl md:text-6xl font-bold text-gray-900 mb-6 leading-tight">
              Welcome back,<br>
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 to-purple-600">
                <%= current_user.first_name %>!
              </span>
            </h1>
            <p class="text-lg md:text-xl text-gray-600 mb-10 max-w-lg">
              Ready to continue your learning journey? Check out our latest courses!
            </p>
          <% else %>
            <span class="inline-block px-4 py-2 rounded-full bg-indigo-100 text-indigo-700 text-sm font-medium mb-6">
              🚀 Transform Your Learning Journey
            </span>
            <h1 class="text-5xl md:text-6xl font-bold text-gray-900 mb-6 leading-tight">
              Learn Without<br>
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 to-purple-600">Limits</span>
            </h1>
            <p class="text-lg md:text-xl text-gray-600 mb-10 max-w-lg">
              Master new skills with our interactive courses, expert instructors, and hands-on projects. Start your learning adventure today!
            </p>
          <% end %>
          
          <div class="flex flex-col sm:flex-row gap-4">
            <%= link_to courses_path, class: "group relative inline-flex items-center justify-center px-8 py-4 overflow-hidden font-medium text-white bg-gradient-to-r from-indigo-600 to-purple-600 rounded-xl hover:shadow-lg hover:shadow-indigo-500/30 transition-all duration-300 transform hover:-translate-y-1" do %>
              <span>Explore Courses</span>
              <i class="fas fa-arrow-right ml-2 group-hover:translate-x-1 transition-transform"></i>
            <% end %>
            
            <%= link_to about_path, class: "group inline-flex items-center justify-center px-8 py-4 font-medium text-gray-700 hover:text-indigo-700 transition-colors" do %>
              <i class="fas fa-play-circle mr-2 text-indigo-600"></i>
              <span>Watch Demo</span>
            <% end %>
          </div>
          
          <div class="mt-12 flex items-center space-x-4">
            <div class="flex -space-x-3">
              <div class="w-10 h-10 rounded-full border-2 border-white bg-indigo-100 flex items-center justify-center">
                <i class="fas fa-user-graduate text-indigo-600"></i>
              </div>
              <div class="w-10 h-10 rounded-full border-2 border-white bg-purple-100 flex items-center justify-center -ml-3">
                <i class="fas fa-laptop-code text-purple-600"></i>
              </div>
              <div class="w-10 h-10 rounded-full border-2 border-white bg-pink-100 flex items-center justify-center -ml-3">
                <i class="fas fa-book text-pink-600"></i>
              </div>
            </div>
            <div class="text-sm text-gray-600">
              <p class="font-medium text-gray-900">10,000+ Students</p>
              <p>Trusted by learners worldwide</p>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Hero Image -->
      <div class="lg:w-1/2 relative" data-aos="fade-left" data-aos-duration="800" data-aos-delay="200">
        <div class="relative">
          <div class="absolute -top-10 -left-10 w-64 h-64 bg-indigo-100 rounded-full mix-blend-multiply filter blur-xl opacity-70 animate-blob"></div>
          <div class="absolute top-20 -right-10 w-64 h-64 bg-purple-100 rounded-full mix-blend-multiply filter blur-xl opacity-70 animate-blob animation-delay-2000"></div>
          <div class="absolute -bottom-10 left-20 w-64 h-64 bg-pink-100 rounded-full mix-blend-multiply filter blur-xl opacity-70 animate-blob animation-delay-4000"></div>
          
          <div class="relative rounded-2xl bg-white/80 backdrop-blur-xl p-8 shadow-2xl border border-white/20 overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-br from-white/80 to-white/20"></div>
            <div class="relative z-10">
              <h3 class="text-2xl font-bold text-gray-900 mb-4">Featured Course</h3>
              <div class="h-48 relative mb-4">
                <iframe width="100%" height="100%" src="https://www.youtube.com/embed/RkAXDGnz0FQ" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
              </div>
              <h4 class="font-semibold text-lg text-gray-900 mb-2">Master Web Development</h4>
              <p class="text-gray-600 text-sm mb-4">Learn to build modern web applications with the latest technologies.</p>
              <div class="flex items-center justify-between">
                <div class="flex items-center text-sm text-gray-500">
                  <i class="fas fa-star text-yellow-400 mr-1"></i>
                  <span>4.9 (1.2k reviews)</span>
                </div>
                <span class="text-sm font-medium text-indigo-600">Enroll Now →</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Scroll Indicator -->
  <div class="absolute bottom-10 left-1/2 transform -translate-x-1/2">
    <div class="flex flex-col items-center">
      <span class="text-sm text-gray-500 mb-2">Scroll to explore</span>
      <div class="w-6 h-10 border-2 border-gray-300 rounded-full flex justify-center">
        <div class="w-1 h-2 bg-gray-400 rounded-full animate-bounce mt-2"></div>
      </div>
    </div>
  </div>
</section>

