<div class="hero-section">
  <div class="hero-content">
    <h1 class="hero-title">
      Welcome to <span class="text-gradient">Tutorx</span>
    </h1>
    <p class="hero-subtitlectext-gradient text-size-2xl">
      Your gateway to endless learning opportunities. Explore courses, take tests, and expand your knowledge with our comprehensive learning platform.
    </p>
    <div class="hero-actions">
      <%= link_to "Get Started", courses_path, class: "btn-primary" %>
      <%= link_to "Learn More", about_path, class: "btn-secondary" %>
    </div>
  </div>
  <div class="hero-image">
    <i class="fas fa-graduation-cap"></i>
  </div>
</div>

<div class="features-section">
  <h2 class="section-title">Why Choose Tutorx?</h2>
  <div class="features-grid">
    <div class="feature-card">
      <div class="feature-icon">
        <i class="fas fa-book-open"></i>
      </div>
      <h3>Comprehensive Courses</h3>
      <p>Access thousands of courses across various subjects taught by expert instructors.</p>
    </div>
    <div class="feature-card">
      <div class="feature-icon">
        <i class="fas fa-clipboard-check"></i>
      </div>
      <h3>Interactive Tests</h3>
      <p>Test your knowledge with our comprehensive assessment system and track your progress.</p>
    </div>
    <div class="feature-card">
      <div class="feature-icon">
        <i class="fas fa-users"></i>
      </div>
      <h3>Community Learning</h3>
      <p>Join a community of learners and educators to share knowledge and grow together.</p>
    </div>
  </div>
</div>

<div class="stats-section">
  <div class="stats-container">
    <div class="stat-item">
      <div class="stat-number">10,000+</div>
      <div class="stat-label">Students</div>
    </div>
    <div class="stat-item">
      <div class="stat-number">500+</div>
      <div class="stat-label">Courses</div>
    </div>
    <div class="stat-item">
      <div class="stat-number">50+</div>
      <div class="stat-label">Instructors</div>
    </div>
    <div class="stat-item">
      <div class="stat-number">95%</div>
      <div class="stat-label">Success Rate</div>
    </div>
  </div>
</div>

<div class="features-section">
  <h2 class="section-title">Popular Learning Paths</h2>
  <div class="features-grid">
    <div class="feature-card">
      <div class="feature-icon">
        <i class="fas fa-code"></i>
      </div>
      <h3>Web Development</h3>
      <p>Master HTML, CSS, JavaScript, and modern frameworks like React and Node.js.</p>
    </div>
    <div class="feature-card">
      <div class="feature-icon">
        <i class="fas fa-chart-line"></i>
      </div>
      <h3>Data Science</h3>
      <p>Learn Python, R, machine learning, and data visualization techniques.</p>
    </div>
    <div class="feature-card">
      <div class="feature-icon">
        <i class="fas fa-mobile-alt"></i>
      </div>
      <h3>Mobile Development</h3>
      <p>Build iOS and Android apps with React Native, Flutter, and native technologies.</p>
    </div>
    <div class="feature-card">
      <div class="feature-icon">
        <i class="fas fa-palette"></i>
      </div>
      <h3>Design</h3>
      <p>Master UI/UX design principles, graphic design, and design tools.</p>
    </div>
    <div class="feature-card">
      <div class="feature-icon">
        <i class="fas fa-briefcase"></i>
      </div>
      <h3>Business</h3>
      <p>Learn business fundamentals, marketing, finance, and entrepreneurship.</p>
    </div>
    <div class="feature-card">
      <div class="feature-icon">
        <i class="fas fa-language"></i>
      </div>
      <h3>Programming Languages</h3>
      <p>Master new Programming languages with interactive courses and native speakers.</p>
    </div>
  </div>
</div>

<div class="cta-section">
  <div class="container mx-auto px-4 py-16 text-center">
    <h2 class="text-3xl font-bold mb-6">Ready to Start Your Learning Journey?</h2>
    <p class="text-xl text-gray-600 mb-8 max-w-2xl mx-auto">
      Join thousands of learners who are already advancing their careers with Tutorx.
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <%= link_to "Browse Courses", courses_path, class: "btn-primary" %>
      <%= link_to "Take a Test", tests_path, class: "btn-secondary" %>
    </div>
  </div>
</div>