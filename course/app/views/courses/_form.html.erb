<%= form_with(model: course, local: true) do |form| %>
  <% if course.errors.any? %>
    <div id="error_explanation" style="background: #f8d7da; color: #721c24; padding: 15px; border-radius: 5px; margin-bottom: 20px;">
      <h2><%= pluralize(course.errors.count, "error") %> prohibited this course from being saved:</h2>
      <ul>
        <% course.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field" style="margin-bottom: 20px;">
    <%= form.label :title %>
    <%= form.text_field :title, style: "width: 100%; padding: 8px; border: 1px solid #ddd; border-radius: 4px;" %>
  </div>

  <div class="field" style="margin-bottom: 20px;">
    <%= form.label :description %>
    <%= form.text_area :description, rows: 4, style: "width: 100%; padding: 8px; border: 1px solid #ddd; border-radius: 4px;" %>
  </div>

  <div class="field" style="margin-bottom: 20px;">
    <%= form.label :content, "Detailed Content (Optional - defaults to description)" %>
    <%= form.text_area :content, rows: 6, style: "width: 100%; padding: 8px; border: 1px solid #ddd; border-radius: 4px;", placeholder: "Enter detailed course overview content..." %>
  </div>

  <div class="field" style="margin-bottom: 20px;">
    <%= form.label :instructor %>
    <%= form.text_field :instructor, style: "width: 100%; padding: 8px; border: 1px solid #ddd; border-radius: 4px;" %>
  </div>

  <div class="field" style="margin-bottom: 20px;">
    <%= form.label :category %>
    <%= form.select :category, Course.categories, {}, style: "width: 100%; padding: 8px; border: 1px solid #ddd; border-radius: 4px;" %>
  </div>

  <div class="field" style="margin-bottom: 20px;">
    <%= form.label :level %>
    <%= form.select :level, Course.levels, {}, style: "width: 100%; padding: 8px; border: 1px solid #ddd; border-radius: 4px;" %>
  </div>

  <div class="field" style="margin-bottom: 20px;">
    <%= form.label :duration, "Duration (hours)" %>
    <%= form.number_field :duration, style: "width: 100%; padding: 8px; border: 1px solid #ddd; border-radius: 4px;" %>
  </div>

  <div class="field" style="margin-bottom: 20px;">
    <%= form.label :price %>
    <%= form.number_field :price, step: 0.01, style: "width: 100%; padding: 8px; border: 1px solid #ddd; border-radius: 4px;" %>
  </div>

  <div class="field" style="margin-bottom: 20px;">
    <%= form.label :image_url, "Image URL" %>
    <%= form.text_field :image_url, style: "width: 100%; padding: 8px; border: 1px solid #ddd; border-radius: 4px;", placeholder: "https://example.com/image.jpg" %>
  </div>

  <div class="field" style="margin-bottom: 20px;">
    <%= form.label :featured, "Featured Course?" %>
    <%= form.check_box :featured %>
  </div>

  <div class="field" style="margin-bottom: 20px;">
    <%= form.label :learning_outcomes, "Learning Outcomes (one per line)" %>
    <%= form.text_area :learning_outcomes, value: (course.learning_outcomes || []).join("\n"), rows: 6, style: "width: 100%; padding: 8px; border: 1px solid #ddd; border-radius: 4px;", placeholder: "Enter each learning outcome on a new line..." %>
    <small style="color: #6c757d;">Enter each learning outcome on a separate line</small>
  </div>

  <div class="field" style="margin-bottom: 20px;">
    <%= form.label :syllabus, "Course Syllabus (JSON format)" %>
    <%= form.text_area :syllabus, value: course.syllabus.present? ? JSON.pretty_generate(course.syllabus) : "", rows: 15, style: "width: 100%; padding: 8px; border: 1px solid #ddd; border-radius: 4px; font-family: monospace;", placeholder: '{"modules": [{"title": "Module 1", "lessons": [{"title": "Lesson 1", "description": "Description", "duration": "10 min", "completed": false}]}]}' %>
    <small style="color: #6c757d;">Enter syllabus in JSON format. See placeholder for example structure.</small>
  </div>

  <div class="actions" style="margin-top: 20px;">
    <%= form.submit style: "padding: 10px 20px; background: #3498db; color: white; border: none; border-radius: 4px; cursor: pointer;" %>
  </div>
<% end %>
