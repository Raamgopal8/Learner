<!DOCTYPE html>
<html>
  <head>
   <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tutorx - Your Learning Platform</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>


  <!-- Favicon -->
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-96x96.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-96x96.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">


   <%= stylesheet_link_tag "application",  media: "all", "data-turbo-track": "reload" %> 
    
    <%= javascript_include_tag "test_timer", "data-turbo-track": "reload" %>
  </head>

  <body class="bg-gray-100 text-gray-900">
    <% if logged_in? %>
      <nav style="background-color: white; box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.06);">
        <div style="max-width: 80rem; margin-left: auto; margin-right: auto; padding-left: 1rem; padding-right: 1rem;">
          <div style="display: flex; justify-content: space-between; height: 4rem; align-items: center;">
            <div style="display: flex;">
              <div style="flex-shrink: 0; display: flex; align-items: center;">
                <a href="/" style="font-size: 1.25rem; font-weight: 700; color: #4f46e5; text-decoration: none;">Tutorx</a>
              </div>
            </div>
            <div style="display: flex; align-items: center;">
              <span style="color: #374151; margin-right: 1rem;">Welcome, <%= current_user&.name || current_user.email %></span>
              <%= button_to "Logout", logout_path, method: :delete, style: "background: none; border: none; color: #6b7280; cursor: pointer; font-size: 1rem;", onmouseover: "this.style.color='#374151'", onmouseout: "this.style.color='#6b7280'" %>
            </div>
          </div>
        </div>
      </nav>
    <% end %>
    <%= yield %>
  </body>
</html>
