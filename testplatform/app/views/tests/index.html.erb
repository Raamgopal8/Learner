<div class="card">
  <h2 class="text-2xl font-semibold mb-4 text-indigo-700">Available Tests</h2>

  <ul>
    <% (@tests || []).each do |test| %>
      <li class="border-b border-gray-200 py-2">
        <a href="/tests/<%= test['id'] %>" class="text-indigo-600 hover:underline">
          <%= test['title'] %>
        </a>
      </li>
    <% end %>
  </ul>
</div>
