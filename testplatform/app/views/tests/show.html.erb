<div class="card">
  <h2><%= @test['title'] %></h2>

  <!-- Timer Section -->
  <div class="timer-container">
    <div class="timer-bar">
      <div id="timer-progress"></div>
    </div>
    <p class="timer-text">
      Time Remaining: <span id="time-display">00:00</span>
    </p>
  </div>

  <form id="test-form" action="/attempts" method="post">
    <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
    <input type="hidden" name="user_id" value="1">
    <input type="hidden" name="test_id" value="<%= @test['id'] %>">

    <% @questions.each_with_index do |q, i| %>
      <div class="question">
        <p>Q<%= i + 1 %>. <%= q['question'] %></p>
        <div class="options">
          <% ['A', 'B', 'C', 'D'].each do |opt| %>
            <label>
              <input type="radio" name="answers[<%= q['id'] %>]" value="<%= opt %>">
              <%= q["option_#{opt.downcase}"] %>
            </label>
          <% end %>
        </div>
      </div>
    <% end %>

    <button type="submit" class="btn-primary">Submit Answers</button>
  </form>
</div>
